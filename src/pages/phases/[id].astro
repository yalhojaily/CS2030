---
import Base from '../../layouts/Base.astro';
import { phases, phaseHours, phaseWeeks, unitHours, weekRange, policyLabel, slug } from '../../data/curriculum';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return phases.map((p) => ({ params: { id: p.id }, props: { phase: p } }));
}
const { phase } = Astro.props;
const [a, b] = weekRange(phase);
---
<Base title={`Phase ${phase.id}: ${phase.title}`} phaseColor={`--p${phase.id}`}>
  <div class="crumbs"><a href={url()}>Roadmap</a><span>Phase {phase.id}</span></div>
  <div class="phase-header">
    <p class="eyebrow">Phase {phase.id} · weeks {a}–{b}</p>
    <h1>{phase.title}</h1>
    <p class="lead">{phase.tagline}</p>
  </div>

  <div class="stats">
    <div class="stat"><b>{phaseHours(phase)}</b><span>hours</span></div>
    <div class="stat"><b>{phaseWeeks(phase)}</b><span>weeks</span></div>
    <div class="stat"><b>{phase.units.length}</b><span>units</span></div>
    <div class="stat"><b data-stat={`pct:${phase.id}`}>0%</b><span>completed</span></div>
  </div>

  <div class="rule"><div class="icon">AGENTS</div><div><b>{policyLabel[phase.agentPolicy]}.</b> {phase.agentRule}</div></div>

  <h2>Units</h2>
  <div class="grid grid-2">
    {phase.units.map((u) => (
      <a class="card unit-card" href={url(`units/${slug(u.id)}`)}>
        <span class="mono">Unit {u.id}</span>
        <h3>{u.title}</h3>
        <div class="muted small">{u.summary}</div>
        <div class="small" style="margin-top:8px">{u.lessons.length} lessons · {unitHours(u)} h · ≈ {(unitHours(u) / 15).toFixed(1)} weeks</div>
        <div class="bar" data-bar={u.id}><i></i></div>
      </a>
    ))}
  </div>

  <h2>Phase defense</h2>
  <p class="muted">Before moving on, pass an oral defense on this phase. <a href={url(`defense#phase-${phase.id}`)}>See the questions and the examiner prompt</a>.</p>
</Base>
